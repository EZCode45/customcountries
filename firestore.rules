rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }
    match /countries/{countryId} {
      allow read: if signedIn();
      allow create: if notBanned() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if notBanned() && request.auth.uid in resource.data.members || isAdmin();
      allow delete: if isAdmin();
    }
    match /territories/{territoryId} {
      allow read: if signedIn();
      allow create: if notBanned() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if notBanned() && resource.data.ownerUid == request.auth.uid || isAdmin();
      allow delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if notBanned() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /alliances/{id} {
      allow read: if signedIn();
      allow create: if notBanned();
      allow update: if notBanned();
      allow delete: if isAdmin();
    }
    match /treaties/{id} {
      allow read: if signedIn();
      allow create: if notBanned();
      allow update: if notBanned();
      allow delete: if isAdmin();
    }
    match /leaderboards/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /adminActions/{id} {
      allow read, write: if isAdmin();
    }
    match /meta/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
